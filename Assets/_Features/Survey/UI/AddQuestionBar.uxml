        <ui:Button name="add-question-button" tooltip="Přidat otázku" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/plus-box-outline.png?fileID=2800000&amp;guid=f36423156a503d3479c3bcfe41cdb280&amp;type=3#plus-box-outline&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 32px; height: 32px; background-color: rgba(188, 188, 188, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0);" />
