<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement style="flex-direction: column; flex-shrink: 0;">
        <ui:TextField name="question-description" placeholder-text="Popis otázky" style="flex-grow: 1; font-size: 16px; color: rgb(0, 0, 0); flex-shrink: 1; white-space: normal;" />
        <ui:VisualElement name="question-attachment" style="flex-grow: 0; flex-direction: row; align-self: flex-end; flex-shrink: 0;">
            <ui:DropdownField label="Pohled kamery" name="camera-view-dropdown" style="flex-shrink: 1;" />
            <ui:Button name="image-button" style="flex-direction: row; justify-content: center; flex-shrink: 1; width: 145px; padding-top: 4px; padding-bottom: 4px; padding-left: 6px; padding-right: 6px; align-self: flex-end; align-items: center;">
                <ui:VisualElement name="icon" style="flex-grow: 0; width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&amp;guid=2a8b0a5a8db48ee46924cdb62930cde7&amp;type=3#image-outline&quot;); flex-shrink: 0;" />
                <ui:Label text="Přidat obrázek" />
            </ui:Button>
        </ui:VisualElement>
        <ui:VisualElement name="camera-view" style="flex-grow: 1; max-height: 200px; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&amp;guid=2a8b0a5a8db48ee46924cdb62930cde7&amp;type=3#image-outline&quot;); height: 200px; -unity-background-scale-mode: scale-to-fit;" />
    </ui:VisualElement>
</ui:UXML>
