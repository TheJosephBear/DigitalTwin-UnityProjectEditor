<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Question-title" src="project://database/Assets/_Features/Survey/UI/Question-title.uxml?fileID=9197481963319205126&amp;guid=7bfed0fc9c8eb204088a09cb69fa7762&amp;type=3#Question-title" />
    <ui:Template name="EditOptionModal" src="project://database/Assets/_Features/Survey/UI/EditOptionModal.uxml?fileID=9197481963319205126&amp;guid=76703d756520966448429ac694633d27&amp;type=3#EditOptionModal" />
    <ui:Template name="Question-description" src="project://database/Assets/_Features/Survey/UI/Question-description.uxml?fileID=9197481963319205126&amp;guid=f5d967f3e76b1a54ea2fffb453a25d93&amp;type=3#Question-description" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    
    <!-- Question Position and Type Header Info -->
    <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-items: center; margin-bottom: 8px;">
        <ui:Label text="1" name="question-position" style="flex-shrink: 1; -unity-font-style: bold; color: rgb(103, 80, 164); font-size: 14px; margin-right: 6px;" />
        <ui:Label text="Label" name="question-type" style="flex-shrink: 1; color: rgb(102, 102, 102); font-size: 11px; background-color: rgb(240, 240, 240); padding-left: 8px; padding-right: 8px; padding-top: 2px; padding-bottom: 2px; border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-left-radius: 10px; border-bottom-right-radius: 10px; -unity-font-style: bold;" />
    </ui:VisualElement>

    <ui:VisualElement name="question-title-bar" style="flex-grow: 0; flex-direction: row; align-items: center; flex-shrink: 0;">
        <ui:Instance template="Question-title" name="Question-title" style="flex-grow: 1;" />
        <ui:Button name="required-toggle" class="required-toggle" style="padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; align-items: center; justify-content: center; margin-right: 0; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/asterisk-crossed.png?fileID=2800000&amp;guid=092533b3b39958b4184c2346388f42f5&amp;type=3#asterisk-crossed&quot;);" />
        <ui:Instance template="EditOptionModal" name="edit-question-modal" style="margin-top: 6px; margin-right: 6px; margin-bottom: 6px; margin-left: 6px;" />
    </ui:VisualElement>
    <ui:Instance template="Question-description" name="question-description" />
</ui:UXML>
