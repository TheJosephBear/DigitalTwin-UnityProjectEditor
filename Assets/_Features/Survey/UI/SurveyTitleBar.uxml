<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="survey-header-card" class="survey-header-card">
        <ui:VisualElement name="survey-title-bar" style="flex-grow: 0; flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:TextField placeholder-text="Název dotazníku" name="question-title" multiline="true" style="flex-grow: 1;" />
        </ui:VisualElement>
        <ui:VisualElement name="survey-description-row" style="flex-direction: row; align-items: center; margin-bottom: 8px;">
            <ui:TextField placeholder-text="Popis dotazníku (volitelné)" name="question-description" multiline="true" style="flex-grow: 1; flex-shrink: 1; min-width: 100px; margin-right: 16px; white-space: normal;" />
            <ui:VisualElement name="question-attachment" class="question-row-actions">
                <ui:DropdownField label="Pohled kamery" name="camera-view-dropdown" class="camera-view-dropdown" />
                <ui:Button name="image-button" class="add-image-button">
                    <ui:VisualElement name="icon" style="flex-grow: 0; width: 18px; height: 18px; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&amp;guid=2a8b0a5a8db48ee46924cdb62930cde7&amp;type=3#image-outline&quot;); flex-shrink: 0; margin-right: 4px;" />
                    <ui:Label text="Přidat obrázek" />
                </ui:Button>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="views" class="media-views-container">
            <ui:VisualElement name="camera-view" class="media-preview-card" style="display: none;">
                <ui:Button name="remove-view" class="icon remove-button" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/close.png?fileID=2800000&amp;guid=36073b272ed400e4fb5cef1e5e174a8d&amp;type=3#close&quot;); right: 4px; position: absolute; top: 4px; width: 22px; height: 22px;" />
                <ui:Button name="enhance-image" class="icon enhance-button" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/magnify-plus-outline.png?fileID=2800000&amp;guid=11b0b51f78ca2b648a63350ae0bd5145&amp;type=3#magnify-plus-outline&quot;); position: absolute; bottom: 4px; right: 4px; width: 22px; height: 22px;" />
            </ui:VisualElement>
            <ui:VisualElement name="question-image" class="media-preview-card" style="display: none;">
                <ui:Button name="remove-image" class="icon remove-button" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/close.png?fileID=2800000&amp;guid=36073b272ed400e4fb5cef1e5e174a8d&amp;type=3#close&quot;); right: 4px; position: absolute; top: 4px; width: 22px; height: 22px;" />
                <ui:Button name="enhance-image" class="icon enhance-button" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/magnify-plus-outline.png?fileID=2800000&amp;guid=11b0b51f78ca2b648a63350ae0bd5145&amp;type=3#magnify-plus-outline&quot;); position: absolute; bottom: 4px; right: 4px; width: 22px; height: 22px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
