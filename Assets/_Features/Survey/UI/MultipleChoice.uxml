<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Question-title" src="project://database/Assets/_Features/Survey/UI/Question-title.uxml?fileID=9197481963319205126&amp;guid=7bfed0fc9c8eb204088a09cb69fa7762&amp;type=3#Question-title" />
    <ui:Template name="Question-description" src="project://database/Assets/_Features/Survey/UI/Question-description.uxml?fileID=9197481963319205126&amp;guid=f5d967f3e76b1a54ea2fffb453a25d93&amp;type=3#Question-description" />
    <ui:Template name="OptionRadio" src="project://database/Assets/_Features/Survey/UI/OptionRadio.uxml?fileID=9197481963319205126&amp;guid=43a53068268e3614a92867fec2dc97e3&amp;type=3#OptionRadio" />
    <ui:VisualElement name="container" style="flex-grow: 1;">
        <ui:VisualElement name="question-title-bar" style="flex-grow: 0; flex-direction: row; align-items: center;">
            <ui:Instance template="Question-title" name="Question-title" style="flex-grow: 1;" />
            <ui:VisualElement name="edit-button" style="flex-grow: 0; width: 32px; height: 32px; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/pencil-outline.png?fileID=2800000&amp;guid=2b11358c908ae27429e1f940d2ac878e&amp;type=3#pencil-outline&quot;);" />
        </ui:VisualElement>
        <ui:Instance template="Question-description" name="Question-description" />
        <ui:VisualElement style="flex-grow: 0; flex-direction: row; align-self: flex-end;">
            <ui:DropdownField label="Camera view" name="camera-view-dropdown" />
            <ui:Button name="image-button" style="flex-direction: row; justify-content: center; flex-shrink: 1; width: 95px; padding-top: 4px; padding-bottom: 4px; padding-left: 6px; padding-right: 6px; align-self: flex-end; align-items: center;">
                <ui:VisualElement name="icon" style="flex-grow: 0; width: 24px; height: 24px; background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&amp;guid=2a8b0a5a8db48ee46924cdb62930cde7&amp;type=3#image-outline&quot;); flex-shrink: 0;" />
                <ui:Label text="Image" />
            </ui:Button>
        </ui:VisualElement>
        <ui:RadioButtonGroup name="Options">
            <ui:Instance template="OptionRadio" />
            <ui:Instance template="OptionRadio" />
        </ui:RadioButtonGroup>
    </ui:VisualElement>
</ui:UXML>
