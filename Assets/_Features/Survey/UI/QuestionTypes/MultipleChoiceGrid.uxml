<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="QuestionTitleBar" src="project://database/Assets/_Features/Survey/UI/QuestionTitleBar.uxml?fileID=9197481963319205126&amp;guid=11e3902c3204be84fb4bb37a97e71bd8&amp;type=3#QuestionTitleBar" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="question-container" style="flex-grow: 1;">
        <ui:Instance template="QuestionTitleBar" name="question-bar" />
        <ui:MultiColumnListView name="grid-table" fixed-item-height="40" style="flex-grow: 1; min-height: 150px;">
            <ui:Columns />
        </ui:MultiColumnListView>
        <ui:VisualElement name="add-buttons" style="flex-grow: 0; flex-direction: row; align-self: stretch; width: 100%; margin-top: 4px;">
            <ui:Button text="+ Přidat řádek" name="add-row-button" style="width: 150px; flex-grow: 0; flex-shrink: 0; margin-right: 2px;" />
            <ui:Button text="+ Přidat sloupec" name="add-column-button" style="flex-grow: 1; flex-shrink: 1; margin-left: 2px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
