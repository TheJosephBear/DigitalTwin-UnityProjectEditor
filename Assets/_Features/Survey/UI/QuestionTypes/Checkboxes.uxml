<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="QuestionTitleBar" src="project://database/Assets/_Features/Survey/UI/QuestionTitleBar.uxml?fileID=9197481963319205126&amp;guid=11e3902c3204be84fb4bb37a97e71bd8&amp;type=3#QuestionTitleBar" />
    <ui:Template name="OptionToggle" src="project://database/Assets/_Features/Survey/UI/OptionToggle.uxml?fileID=9197481963319205126&amp;guid=414cdd6843d6eda4db2380e5e87ed03f&amp;type=3#OptionToggle" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="question-wrapper" class="question-wrapper">
        <ui:VisualElement name="question-move-controls" class="question-move-controls">
            <ui:Button name="move-up-button" class="icon icon-move-up" tooltip="Posunout otázku nahoru" />
            <ui:Button name="move-down-button" class="icon icon-move-down" tooltip="Posunout otázku dolů" />
        </ui:VisualElement>
        <ui:VisualElement name="question-container" class="question-container">
            <ui:Instance template="QuestionTitleBar" name="question-bar" />
            <ui:VisualElement name="options-list" class="options-list">
                <ui:Instance template="OptionToggle" />
            </ui:VisualElement>
            <ui:VisualElement name="add-buttons" class="add-buttons" style="flex-grow: 0; flex-direction: row; justify-content: center; align-self: center; width: 55%; margin-top: 12px;">
                <ui:Button text="Přidat odpověď" name="add-option-button" style="flex-grow: 1; width: 50%;" />
                <ui:Button text="Přidat &quot;Jiná&quot; odpověď" name="add-other-option-button" style="flex-grow: 1; width: 50%;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
