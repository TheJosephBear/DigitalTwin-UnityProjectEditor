<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="QuestionTitleBar" src="project://database/Assets/_Features/Survey/UI/QuestionTitleBar.uxml?fileID=9197481963319205126&amp;guid=11e3902c3204be84fb4bb37a97e71bd8&amp;type=3#QuestionTitleBar" />
    <ui:Template name="ScaleRadio" src="project://database/Assets/_Features/Survey/UI/ScaleRadio.uxml?fileID=9197481963319205126&amp;guid=9eecbf158b612924b8c7681dc9533d9d&amp;type=3#ScaleRadio" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="question-container" style="flex-grow: 1;">
        <ui:Instance template="QuestionTitleBar" name="question-bar" />
        <ui:VisualElement style="flex-grow: 0; flex-direction: row;">
            <ui:TextField placeholder-text="Text možnosti" multiline="true" style="white-space: normal; flex-shrink: 1; align-items: flex-start; align-self: center; width: 150px;" />
            <ui:RadioButtonGroup name="options-list" class="radio-group-grid" style="flex-grow: 1; justify-content: space-evenly;">
                <ui:Instance template="ScaleRadio" style="flex-direction: row;" />
            </ui:RadioButtonGroup>
            <ui:Button text="+ Přidat možnost" name="add-option-button" style="flex-shrink: 1; align-items: auto; align-self: center; white-space: normal; width: 100px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
