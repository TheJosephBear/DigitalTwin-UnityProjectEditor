        <ui:Button name="close-overlay-btn" style="position: absolute; top: 40px; right: 40px; width: 44px; height: 44px; background-color: rgba(255, 255, 255, 0.27); background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/close-white.png?fileID=2800000&amp;guid=80c12ab3b3bf532419bcb9cfa7a76a4c&amp;type=3#close-white&quot;); -unity-background-scale-mode: scale-to-fit; -unity-background-image-tint-color: rgb(255, 255, 255); border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0; border-top-left-radius: 22px; border-top-right-radius: 22px; border-bottom-left-radius: 22px; border-bottom-right-radius: 22px; padding: 10px;" />
    </ui:VisualElement>
