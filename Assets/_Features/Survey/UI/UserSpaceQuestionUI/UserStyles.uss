}

.text-answer-field TextInput:focus {
    border-color: var(--primary-color);
    border-width: 2px;
    background-color: rgb(255, 255, 255);
}

.scale-config-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 12px;
    border-radius: 6px;
}

.scale-config-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    margin-right: 8px;
}

.scale-type-dropdown {
    width: 140px;
    height: 32px;
}

.scale-options-list {
    flex-direction: column;
    width: 100%;
}

.scale-row-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.scale-preview-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 200px;
    margin-right: 8px;
}

.scale-limit-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    min-width: 24px;
    -unity-text-align: middle-center;
}

.scale-slider {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging * {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger {
    background-color: var(--primary-color);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__drag-container {
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__tracker {
    background-color: rgba(103, 80, 164, 0.25);
    height: 6px;
    border-radius: 3px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-dragger-tooltip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
    white-space: nowrap;
}

#unity-dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:focus .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-slider.is-dragging .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-dragger-tooltip.is-dragging {
    opacity: 1;
    scale: 1 1;
}

.add-scale-row-btn {
    width: 150px;
    height: 32px;
    align-items: center;
    justify-content: center;
}

.scale-viewer-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 6px;
    margin-bottom: 6px;
    padding: 8px 12px;
    background-color: rgb(252, 250, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.scale-viewer-row:hover {
    background-color: var(--secondary-background-color);
    border-color: rgba(103, 80, 164, 0.25);
}

.scale-viewer-row-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--dark-text);
    min-width: 40px;
    max-width: 160px;
    flex-grow: 1;
    flex-shrink: 1;
    white-space: normal;
    margin-right: 10px;
}

.scale-value-badge {
    min-width: 28px;
    height: 24px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    border-radius: 12px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    margin-left: 8px;
    flex-shrink: 0;
}

.grid-container {
    margin-top: 16px;
    flex-grow: 0;
}

.grid-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--primary-color);
    margin-bottom: 4px;
}

.grid-header-spacer {
    width: 120px;
    flex-shrink: 0;
}

.grid-header-columns {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.grid-column-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.grid-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    transition-property: background-color;
    transition-duration: 120ms;
}

.grid-row:hover {
    background-color: rgb(250, 246, 255);
}

.grid-row-label {
    width: 120px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--dark-text);
    -unity-text-align: middle-left;
}

.grid-row-options {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.image-choice-grid {
    margin-top: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.image-choice-grid > VisualElement {
    align-self: stretch;
}

.image-choice-grid #contentContainer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.image-choice-grid TemplateContainer {
    flex-shrink: 0;
    width: 190px;
    height: 190px;
    margin-right: 12px;
    margin-bottom: 12px;
}

.image-option-card {
    width: 100%;
    height: 100%;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.08);
    background-color: rgb(252, 250, 255);
    flex-direction: column;
    overflow: hidden;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-property: border-color, background-color;
    transition-duration: 180ms;
}

.image-option-card:hover {
    border-color: var(--primary-color);
    background-color: var(--secondary-background-color);
}

.image-option-card--selected {
    border-color: var(--primary-color);
    border-width: 3px;
    background-color: var(--secondary-background-color);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.image-option-preview {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&guid=2a8b0a5a8db48ee46924cdb62930cde7&type=3#image-outline");
    background-color: rgb(245, 242, 250);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    min-height: 100%;
}

.image-option-label {
    height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.9);
}

.image-option-label Label {
    font-size: 11px;
    color: var(--dark-text);
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.options-list-vertical {
    margin-top: 16px;
    align-self: stretch;
}



.option-row .other-text-input {
    flex-grow: 1;
    margin-right: 8px;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.option-row .other-text-input TextInput {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    font-size: 14px;
    color: rgb(30, 30, 30);
}

/* ==========================================================================
   GRID MATRIX QUESTION & TABLE STYLING
   ========================================================================== */

#grid-table {
    flex-grow: 1;
    min-height: 180px;
    max-height: 350px;
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
}

#grid-table .unity-multi-column-header {
    min-height: 48px;
    height: 48px;
    background-color: rgb(247, 242, 250);
    border-bottom-width: 1px;
    border-bottom-color: rgba(103, 80, 164, 0.18);
    margin: 0;
    padding: 0;
}

#grid-table .unity-multi-column-header__column {
    justify-content: center;
    align-items: center;
    padding: 4px 6px;
    margin: 0;
    background-color: transparent;
    border-right-width: 1px;
    border-right-color: rgba(103, 80, 164, 0.1);
}

#grid-table .unity-multi-column-header__column-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(73, 62, 105);
    -unity-text-align: middle-center;
}

#grid-table .unity-multi-column-list-view__row {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    margin: 0;
    padding: 0;
    align-items: center;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.05);
    transition-duration: 0.15s;
}

#grid-table .unity-multi-column-list-view__row:hover {
    background-color: rgba(103, 80, 164, 0.04);
}

#grid-table .unity-collection-view__item--selected,
#grid-table .unity-list-view__item--selected,
#grid-table .unity-multi-column-view__row--selected,
#grid-table .unity-multi-column-list-view__row--selected,
#grid-table .unity-collection-view__item:active,
#grid-table .unity-list-view__item:active,
#grid-table .unity-multi-column-view__row:active,
#grid-table .unity-multi-column-list-view__row:active {
    background-color: transparent;
}

#grid-table .unity-multi-column-list-view__cell {
    height: 44px;
    min-height: 44px;
    max-height: 44px;
    justify-content: center;
    align-items: center;
    padding: 0;
    margin: 0;
    border-right-width: 1px;
    border-right-color: rgba(0, 0, 0, 0.04);
}

#grid-table .unity-multi-column-list-view__cell Label {
    margin: 0;
    padding-left: 10px;
    padding-right: 6px;
    font-size: 13px;
    color: var(--dark-text);
    -unity-text-align: middle-left;
}

/* Grid Cell Toggle / Radio Elements */
#grid-table .unity-multi-column-list-view__cell Toggle,
#grid-table .unity-multi-column-list-view__cell .grid-radio-toggle,
#grid-table .unity-multi-column-list-view__cell .grid-checkbox-toggle {
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    max-width: 26px;
    max-height: 26px;
    align-self: center;
    justify-content: center;
    align-items: center;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#grid-table .unity-multi-column-list-view__cell .unity-base-field__label,
#grid-table .unity-multi-column-list-view__cell .unity-toggle__text {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

#grid-table .unity-multi-column-list-view__cell .unity-base-field__input,
#grid-table .unity-multi-column-list-view__cell .unity-toggle__input {
    width: 26px;
    height: 26px;
    min-width: 26px;
    min-height: 26px;
    max-width: 26px;
    max-height: 26px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
    justify-content: center;
    align-items: center;
}

/* Radio button in grid (Circle) */
#grid-table .grid-radio-toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    border-radius: 50%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    border-width: 2px;
    border-color: rgba(103, 80, 164, 0.4);
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    margin: 0;
    padding: 0;
    align-self: center;
    flex-shrink: 0;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

#grid-table .grid-radio-toggle:hover .unity-toggle__checkmark {
    border-color: var(--primary-color);
    background-color: var(--primary-background-color);
}

#grid-table .grid-radio-toggle:checked .unity-toggle__checkmark {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/dot-white.png?fileID=2800000&guid=a123529c3fb34d638d526d7deabd69f5&type=3#dot-white");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Checkbox in grid (Square) */
#grid-table .grid-checkbox-toggle .unity-toggle__checkmark {
    width: 24px;
    height: 24px;
    min-width: 24px;
    min-height: 24px;
    max-width: 24px;
    max-height: 24px;
    border-radius: 6px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-width: 2px;
    border-color: rgba(103, 80, 164, 0.4);
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    margin: 0;
    padding: 0;
    align-self: center;
    flex-shrink: 0;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

#grid-table .grid-checkbox-toggle:hover .unity-toggle__checkmark {
    border-color: var(--primary-color);
    background-color: var(--primary-background-color);
}

#grid-table .grid-checkbox-toggle:checked .unity-toggle__checkmark {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/check-white.png?fileID=2800000&guid=631e4421e2e8456f9d8d1bb1e039336b&type=3#check-white");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Scrollbars styling for Grid Table */
#grid-table .unity-scroll-view__horizontal-scroller,
#grid-table .unity-list-view__scroll-view .unity-scroll-view__horizontal-scroller {
    height: 8px;
    min-height: 8px;
    background-color: rgba(0, 0, 0, 0.04);
    border-radius: 4px;
    margin: 2px;
}

#grid-table .unity-scroll-view__vertical-scroller,
#grid-table .unity-list-view__scroll-view .unity-scroll-view__vertical-scroller {
    width: 8px;
    min-width: 8px;
    background-color: rgba(0, 0, 0, 0.04);
    border-radius: 4px;
    margin: 2px;
}

#grid-table .unity-scroller__dragger,
#grid-table .unity-base-slider__dragger {
    background-color: rgba(103, 80, 164, 0.4);
    border-radius: 4px;
    border-width: 0;
    min-width: 6px;
    min-height: 6px;
}

#grid-table .unity-scroller__dragger:hover,
#grid-table .unity-base-slider__dragger:hover {
    background-color: var(--primary-color);
}

.icon-trash {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/trash-can-outline.png?fileID=2800000&guid=7ad15b4efd0e279438b167e4bed1c7e6&type=3#trash-can-outline");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    background-color: transparent;
    border-width: 0;
    margin-left: 2px;
    margin-right: 2px;
    opacity: 0.55;
    transition-duration: 0.15s;
}

.icon-trash:hover {
    opacity: 1;
    -unity-background-image-tint-color: rgb(229, 57, 53);
}

.icon-move-up {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-up.png?fileID=2800000&guid=13e6e2a9f27e5874eab92e305adb3fa1&type=3#chevron-up");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    background-color: transparent;
    border-width: 0;
    margin-left: 2px;
    margin-right: 2px;
    opacity: 0.55;
    transition-duration: 0.15s;
}

.icon-move-up:hover {
    opacity: 1;
    -unity-background-image-tint-color: rgb(103, 80, 164);
}

.icon-move-down {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-down.png?fileID=2800000&guid=d1a74cec442a2284589bab0730540f72&type=3#chevron-down");
    -unity-background-scale-mode: scale-to-fit;
    width: 20px;
    height: 20px;
    background-color: transparent;
    border-width: 0;
    margin-left: 2px;
    margin-right: 2px;
    opacity: 0.55;
    transition-duration: 0.15s;
}

.icon-move-down:hover {
    opacity: 1;
    -unity-background-image-tint-color: rgb(103, 80, 164);
}

#add-buttons {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

#add-row-button {
    height: 38px;
    background-color: rgb(103, 80, 164);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 0;
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 0.15s;
}

#add-row-button:hover {
    background-color: rgb(83, 62, 133);
}

#add-column-button {
    height: 38px;
    background-color: rgb(232, 222, 248);
    color: rgb(29, 25, 43);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 0.15s;
}

#add-column-button:hover {
    background-color: rgb(216, 206, 232);
}

.enhance-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.remove-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.enhance-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.05 1.05;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.remove-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.05 1.05;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.enhance-button:active {
    background-color: rgb(220, 220, 220);
    scale: 1 1;
}

.remove-button:active {
    background-color: rgb(220, 220, 220);
    scale: 1 1;
}

/* ==========================================================================
   RUNTIME TOOLTIP STYLING
   ========================================================================== */

#tooltipLabel,
.custom-tooltip-label {
    position: absolute;
    background-color: rgb(32, 26, 44);
    color: rgb(255, 255, 255);
    border-radius: 7px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: normal;
    white-space: normal;
    max-width: 250px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    display: none;
    -unity-text-align: middle-left;
}

