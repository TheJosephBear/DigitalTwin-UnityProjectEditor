.unity-radio-button:checked .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.user-option-radio:checked .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.option-row .unity-radio-button:checked .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.unity-radio-button__checkmark-background:checked > .unity-radio-button__checkmark {
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

/* Direct checkmark fallback (when Unity doesn't nest in checkmark-background) */
.unity-radio-button .unity-radio-button__input > .unity-radio-button__checkmark,
.user-option-radio .unity-radio-button__input > .unity-radio-button__checkmark,
