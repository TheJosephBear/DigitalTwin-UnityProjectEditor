    background-image: none;
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
}

/* Radio Button Checked (Outer circle turns solid primary purple) */
.option-row .unity-radio-button:checked .unity-radio-button__checkmark-background,
.option-row .unity-radio-button:checked .unity-radio-button__input > .unity-radio-button__checkmark-background,
.user-option-radio:checked .unity-radio-button__checkmark-background,
.user-option-radio:checked .unity-radio-button__input > .unity-radio-button__checkmark-background,
.unity-radio-button:checked .unity-radio-button__checkmark-background,
