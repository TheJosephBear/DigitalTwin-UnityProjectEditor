}

/* Inner Dot (checkmark inside checkmark-background) */
.unity-radio-button .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.user-option-radio .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.option-row .unity-radio-button .unity-radio-button__checkmark-background > .unity-radio-button__checkmark,
.unity-radio-button__checkmark-background > .unity-radio-button__checkmark {
    width: 10px;
    height: 10px;
    min-width: 10px;
    min-height: 10px;
    max-width: 10px;
    max-height: 10px;
    border-radius: 50%;
    border-top-left-radius: 50%;
    border-top-right-radius: 50%;
    border-bottom-right-radius: 50%;
    border-bottom-left-radius: 50%;
    background-color: transparent;
    background-image: none;
