RadioButtonGroup #contentContainer {
    flex-direction: column;
    flex-wrap: nowrap;
    width: 100%;
    justify-content: flex-start;
}

#option-container {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.radio_no-margin > VisualElement {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.radio-group-vertical #contentContainer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.radio-group-grid #contentContainer {
    justify-content: space-around;
    align-items: center;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

Button {
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-left-radius: 12px;
    border-top-width: 0;
