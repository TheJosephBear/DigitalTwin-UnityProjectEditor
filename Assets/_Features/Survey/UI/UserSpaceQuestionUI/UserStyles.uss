:root {
    --primary-color: rgb(103, 80, 164);
    --secondary-color: rgb(73, 62, 105);
    --primary-background-color: rgb(247, 242, 250);
    --secondary-background-color: rgb(246, 230, 255);
    --dark-text: rgb(29, 27, 32);
    --muted-text: rgb(102, 102, 102);
    --border-color: rgba(0, 0, 0, 0.08);
}

#page-container {
    position: absolute;
    right: 24px;
    top: 24px;
    bottom: 24px;
    width: 420px;
    background-color: rgba(255, 255, 255, 0.98);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-width: 1px;
    border-color: var(--border-color);
    overflow: visible;
}

#header-container {
    height: 60px;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    background-color: rgb(250, 250, 250);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

#header-icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/icons8-survey-96.png?fileID=2800000&guid=e4cbf49ef86a87f4e8d7f185fd605cf8&type=3#icons8-survey-96");
    -unity-background-scale-mode: scale-to-fit;
}

#title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--dark-text);
    margin: 0;
    padding: 0;
}

#survey-scroll-view {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
}

#survey-scroll-view > #unity-content-container,
#survey-scroll-view > .unity-scroll-view__content-container {
    flex-grow: 1;
    min-height: 100%;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
}

#survey-first-page {
    flex-grow: 1;
    min-height: 100%;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 32px;
}

#survey-first-page #survey-title {
    -unity-text-align: middle-center;
    font-size: 22px;
    margin-bottom: 16px;
}

#survey-first-page #question-description {
    -unity-text-align: middle-center;
    font-size: 15px;
    margin-bottom: 20px;
}

#survey-thank-you-page {
    flex-grow: 1;
    min-height: 100%;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 32px;
}

#thank-you-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/icons8-survey-96.png?fileID=2800000&guid=e4cbf49ef86a87f4e8d7f185fd605cf8&type=3#icons8-survey-96");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--primary-color);
}

#thank-you-title {
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--dark-text);
    margin-bottom: 12px;
    white-space: normal;
}

#thank-you-description {
    -unity-text-align: middle-center;
    font-size: 15px;
    color: var(--muted-text);
    margin-bottom: 28px;
    white-space: normal;
}

.thank-you-btn {
    height: 42px;
    min-width: 160px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 21px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-width: 0;
}

.thank-you-btn:hover {
    background-color: rgb(83, 62, 140);
}

#bottom-bar {
    height: 64px;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    border-top-width: 1px;
    border-top-color: var(--border-color);
    background-color: rgb(250, 250, 250);
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.nav-btn {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-width: 0;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 55% 55%;
}

#previous-btn {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-left.png?fileID=2800000&guid=4ab49af5e05cd304a88ca8241e489d55&type=3#chevron-left");
    background-color: rgb(240, 240, 240);
}

#previous-btn:hover {
    background-color: rgb(228, 228, 228);
}

#next-btn {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-right.png?fileID=2800000&guid=05c0e935411a9e64383e2a9a89216d33&type=3#chevron-right");
    background-color: var(--primary-color);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

#next-btn:hover {
    background-color: rgb(83, 62, 140);
}

#next-btn.submit-btn {
    width: auto;
    min-width: 100px;
    height: 40px;
    padding-left: 18px;
    padding-right: 18px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-image: none;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

#next-btn.submit-btn:hover {
    background-color: rgb(83, 62, 140);
    color: rgb(255, 255, 255);
}

#next-btn.submit-btn:active {
    background-color: rgb(65, 45, 120);
    color: rgb(255, 255, 255);
}

#page-count-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--muted-text);
    -unity-text-align: middle-center;
}

#toggle-btn {
    width: 32px;
    height: 32px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/arrow-collapse-right.png?fileID=2800000&guid=2b6de49098cd4b94f85d1faeaba9f409&type=3#arrow-collapse-right");
    background-size: 65% 65%;
    -unity-background-scale-mode: scale-to-fit;
}

#toggle-btn:hover {
    background-color: rgb(240, 240, 240);
}

#question-header-info {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
}

#question-position {
    flex-shrink: 1;
    -unity-font-style: bold;
    color: var(--primary-color);
    font-size: 14px;
    margin-right: 6px;
}

#question-type {
    flex-shrink: 1;
    color: var(--muted-text);
    font-size: 11px;
    background-color: rgb(240, 240, 240);
    padding-left: 8px;
    padding-right: 8px;
    padding-top: 2px;
    padding-bottom: 2px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    -unity-font-style: bold;
}

RadioButton > Label {
    flex-grow: 1;
    flex-shrink: 0;
}

RadioButton > VisualElement {
    flex-shrink: 1;
    max-width: 24px;
    min-width: 24px;
    width: 24px;
}

Toggle > Label {
    flex-grow: 1;
    flex-shrink: 0;
}

Toggle > VisualElement {
    flex-shrink: 1;
    max-width: 24px;
    min-width: 24px;
    width: 24px;
    margin-right: 8px;
}

RadioButtonGroup #contentContainer {
    flex-direction: column;
    flex-wrap: nowrap;
    width: 100%;
    justify-content: flex-start;
}

#option-container {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.radio_no-margin > VisualElement {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.radio-group-vertical #contentContainer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.radio-group-grid #contentContainer {
    justify-content: space-around;
    align-items: center;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

Button {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-left-radius: 8px;
    background-color: var(--primary-background-color);
    color: var(--primary-color);
}

Button:hover {
    background-color: var(--secondary-background-color);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

Button VisualElement:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

Button Label:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

TextField TextElement:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/ibeam_32thin.png?fileID=2800000&guid=02d5e55818938834894e19a703e94dab&type=3#ibeam_32thin") 16 16;
}

TextField TextInput:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/ibeam_32thin.png?fileID=2800000&guid=02d5e55818938834894e19a703e94dab&type=3#ibeam_32thin") 16 16;
}

TextField TextInput {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#question-container {
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.question-card {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-width: 1px;
    border-color: var(--border-color);
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    margin-bottom: 16px;
}

.question-card--required {
    border-left-width: 3px;
    border-left-color: var(--primary-color);
}

.option-row {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 6px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
    background-color: rgb(252, 250, 255);
    transition-property: background-color, border-color;
    transition-duration: 150ms;
}

.option-row:hover {
    background-color: var(--secondary-background-color);
    border-color: rgba(103, 80, 164, 0.25);
}

.option-row--other {
    background-color: rgb(240, 240, 243);
    border-color: rgba(0, 0, 0, 0.12);
}

.option-row--other:hover {
    background-color: rgb(232, 232, 236);
    border-color: rgba(103, 80, 164, 0.35);
}

.other-text-input {
    flex-grow: 1;
    margin-left: 8px;
    margin-right: 0;
    margin-top: 0;
    margin-bottom: 0;
}

.other-text-input > .unity-base-text-field__input,
.other-text-input > #unity-text-input,
.other-text-input .unity-base-text-field__input,
.other-text-input #unity-text-input,
.other-text-input TextInput {
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.25);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 14px;
    color: rgb(30, 30, 30);
    transition-property: border-color, background-color;
    transition-duration: 150ms;
}

.other-text-input:hover > .unity-base-text-field__input,
.other-text-input:hover > #unity-text-input,
.other-text-input:hover .unity-base-text-field__input,
.other-text-input:hover #unity-text-input,
.other-text-input:hover TextInput {
    border-color: var(--primary-color);
    background-color: rgb(255, 255, 255);
}

.other-text-input:focus > .unity-base-text-field__input,
.other-text-input:focus > #unity-text-input,
.other-text-input:focus .unity-base-text-field__input,
.other-text-input:focus #unity-text-input,
.other-text-input:focus TextInput {
    border-color: var(--primary-color);
    border-width: 1.5px;
    background-color: rgb(255, 255, 255);
}

.question-divider {
    height: 1px;
    background-color: var(--border-color);
    margin-top: 12px;
    margin-bottom: 12px;
    flex-grow: 0;
}

.options-list-container {
    margin-top: 16px;
    flex-grow: 0;
}

.text-answer-field {
    margin-top: 16px;
    flex-grow: 0;
}

.text-answer-field TextInput {
    min-height: 80px;
    padding-top: 12px;
    padding-bottom: 12px;
    padding-left: 14px;
    padding-right: 14px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-left-radius: 10px;
    border-bottom-right-radius: 10px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.12);
    background-color: rgb(250, 248, 253);
    font-size: 14px;
    color: var(--dark-text);
    transition-property: border-color;
    transition-duration: 150ms;
}

.text-answer-field TextInput:focus {
    border-color: var(--primary-color);
    border-width: 2px;
    background-color: rgb(255, 255, 255);
}

.scale-config-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 12px;
    border-radius: 6px;
}

.scale-config-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    margin-right: 8px;
}

.scale-type-dropdown {
    width: 140px;
    height: 32px;
}

.scale-options-list {
    flex-direction: column;
    width: 100%;
}

.scale-row-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.scale-preview-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 200px;
    margin-right: 8px;
}

.scale-limit-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    min-width: 24px;
    -unity-text-align: middle-center;
}

.scale-slider {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging * {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger {
    background-color: var(--primary-color);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__drag-container {
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__tracker {
    background-color: rgba(103, 80, 164, 0.25);
    height: 6px;
    border-radius: 3px;
    overflow: visible;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-dragger-tooltip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
    white-space: nowrap;
}

#unity-dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:focus .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-slider.is-dragging .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-dragger-tooltip.is-dragging {
    opacity: 1;
    scale: 1 1;
}

.add-scale-row-btn {
    width: 150px;
    height: 32px;
    align-items: center;
    justify-content: center;
}

.scale-viewer-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
    border-width: 1px;
    border-color: var(--border-color);
}

.scale-viewer-row-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(40, 40, 40);
    min-width: 160px;
    max-width: 250px;
    flex-shrink: 0;
    white-space: normal;
}

.scale-value-badge {
    min-width: 32px;
    height: 28px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 12px;
}

.grid-container {
    margin-top: 16px;
    flex-grow: 0;
}

.grid-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom-width: 2px;
    border-bottom-color: var(--primary-color);
    margin-bottom: 4px;
}

.grid-header-spacer {
    width: 120px;
    flex-shrink: 0;
}

.grid-header-columns {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.grid-column-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    -unity-text-align: middle-center;
    flex-grow: 1;
}

.grid-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 4px;
    padding-right: 4px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    transition-property: background-color;
    transition-duration: 120ms;
}

.grid-row:hover {
    background-color: rgb(250, 246, 255);
}

.grid-row-label {
    width: 120px;
    flex-shrink: 0;
    font-size: 13px;
    color: var(--dark-text);
    -unity-text-align: middle-left;
}

.grid-row-options {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.image-choice-grid {
    margin-top: 16px;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.image-choice-grid > VisualElement {
    align-self: stretch;
}

.image-choice-grid #contentContainer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.image-choice-grid TemplateContainer {
    flex-shrink: 0;
    width: 190px;
    height: 190px;
    margin-right: 12px;
    margin-bottom: 12px;
}

.image-option-card {
    width: 100%;
    height: 100%;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0.08);
    background-color: rgb(252, 250, 255);
    flex-direction: column;
    overflow: hidden;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    transition-property: border-color, background-color;
    transition-duration: 180ms;
}

.image-option-card:hover {
    border-color: var(--primary-color);
    background-color: var(--secondary-background-color);
}

.image-option-card--selected {
    border-color: var(--primary-color);
    border-width: 3px;
    background-color: var(--secondary-background-color);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.image-option-preview {
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/image-outline.png?fileID=2800000&guid=2a8b0a5a8db48ee46924cdb62930cde7&type=3#image-outline");
    background-color: rgb(245, 242, 250);
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    min-height: 100%;
}

.image-option-label {
    height: 32px;
    padding-left: 8px;
    padding-right: 8px;
    justify-content: center;
    align-items: center;
    background-color: rgba(255, 255, 255, 0.9);
}

.image-option-label Label {
    font-size: 11px;
    color: var(--dark-text);
    -unity-text-align: middle-center;
    overflow: hidden;
    text-overflow: ellipsis;
}

.options-list-vertical {
    margin-top: 16px;
    align-self: stretch;
}

.option-row RadioButton {
    flex-direction: row-reverse;
    flex-grow: 1;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.option-row Toggle {
    flex-direction: row-reverse;
    flex-grow: 1;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.option-row RadioButton > VisualElement {
    margin-right: 5px;
}

.option-row Toggle > VisualElement {
    margin-right: 5px;
}

.option-row .other-text-input {
    flex-grow: 1;
