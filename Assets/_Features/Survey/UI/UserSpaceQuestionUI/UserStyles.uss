    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.option-row:hover {
    background-color: var(--secondary-background-color);
    border-color: rgba(103, 80, 164, 0.25);
}

.option-row RadioButton,
.option-row Toggle,
.user-option-radio,
.user-option-toggle {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: transparent;
}

