   -------------------------------------------------------------------------- */

/* Outer Circle (checkmark-background) */
.unity-radio-button__checkmark-background,
.unity-radio-button .unity-radio-button__checkmark-background,
.unity-radio-button .unity-radio-button__input > .unity-radio-button__checkmark-background,
.user-option-radio .unity-radio-button__checkmark-background,
