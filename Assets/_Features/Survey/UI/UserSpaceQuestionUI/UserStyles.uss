}

.unity-base-text-field__placeholder-label,
.unity-base-text-field__input--placeholder,
.unity-base-text-field__placeholder {
    color: rgb(150, 145, 160);
}

#question-container {
    padding-top: 24px;
    padding-right: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
}

.question-card {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-width: 1.5px;
    border-color: rgba(103, 80, 164, 0.15);
    padding-top: 20px;
    padding-right: 20px;
    padding-bottom: 20px;
    padding-left: 20px;
    margin-bottom: 16px;
    transition-property: border-color;
    transition-duration: 0.15s;
}

.question-card--required {
    border-left-width: 3px;
    border-left-color: var(--primary-color);
}

.option-row {
    flex-direction: row;
    align-items: center;
    padding-top: 10px;
    padding-bottom: 10px;
    padding-left: 12px;
    padding-right: 12px;
    margin-bottom: 6px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.06);
