    transition-duration: 0.15s;
}

.icon-move-down:hover {
    opacity: 1;
    -unity-background-image-tint-color: rgb(103, 80, 164);
}

#add-buttons {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

#add-row-button {
    height: 38px;
    background-color: rgb(103, 80, 164);
    color: rgb(255, 255, 255);
    border-radius: 8px;
    border-width: 0;
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 0.15s;
}

#add-row-button:hover {
    background-color: rgb(83, 62, 133);
}

#add-column-button {
    height: 38px;
    background-color: rgb(232, 222, 248);
    color: rgb(29, 25, 43);
    border-radius: 8px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
    -unity-font-style: bold;
    font-size: 13px;
    transition-duration: 0.15s;
}

#add-column-button:hover {
    background-color: rgb(216, 206, 232);
}

.enhance-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.remove-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.enhance-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.05 1.05;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.remove-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.05 1.05;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.enhance-button:active {
    background-color: rgb(220, 220, 220);
    scale: 1 1;
}

.remove-button:active {
    background-color: rgb(220, 220, 220);
    scale: 1 1;
}
