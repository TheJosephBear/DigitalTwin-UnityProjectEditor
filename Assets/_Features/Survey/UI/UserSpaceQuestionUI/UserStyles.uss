:root {
    --primary-color: rgb(103, 80, 164);
    --secondary-color: rgb(73, 62, 105);
    --primary-background-color: rgb(247, 242, 250);
    --secondary-background-color: rgb(246, 230, 255);
    --dark-text: rgb(29, 27, 32);
    --muted-text: rgb(102, 102, 102);
    --border-color: rgba(0, 0, 0, 0.08);
    --input-bg: rgb(247, 245, 250);
    --input-hover-bg: rgb(242, 239, 247);
    --input-focus-bg: rgb(255, 255, 255);
}

#page-container {
    position: absolute;
    right: 24px;
    top: 24px;
    bottom: 24px;
    width: 420px;
    background-color: rgba(255, 255, 255, 0.98);
    border-top-left-radius: 16px;
    border-top-right-radius: 16px;
    border-bottom-left-radius: 16px;
    border-bottom-right-radius: 16px;
    border-width: 1px;
    border-color: var(--border-color);
    overflow: visible;
}

#header-container {
    height: 60px;
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    border-bottom-width: 1px;
    border-bottom-color: var(--border-color);
    background-color: rgb(250, 250, 250);
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
}

#header-icon {
    width: 24px;
    height: 24px;
    margin-right: 10px;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/icons8-survey-96.png?fileID=2800000&guid=e4cbf49ef86a87f4e8d7f185fd605cf8&type=3#icons8-survey-96");
    -unity-background-scale-mode: scale-to-fit;
}

#title {
    font-size: 16px;
    -unity-font-style: bold;
    color: var(--dark-text);
    margin: 0;
    padding: 0;
}

#survey-scroll-view {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
}

#survey-scroll-view > #unity-content-container,
#survey-scroll-view > .unity-scroll-view__content-container {
    flex-grow: 1;
    min-height: 100%;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 24px;
    padding-right: 24px;
}

/* ==========================================================================
   SCROLLER & SCROLLBAR STYLING (ScrollView, Dragger, Tracker, Low/High Buttons)
   ========================================================================== */

.unity-scroller,
#survey-scroll-view .unity-scroller {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 12px;
    margin-left: 0;
    position: relative;
}

.unity-scroller--vertical,
.unity-scroller.unity-scroller--vertical,
#survey-scroll-view .unity-scroller--vertical {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    background-color: transparent;
    border-width: 0;
    margin-right: 12px;
    margin-top: 8px;
    margin-bottom: 8px;
    position: relative;
}

.unity-scroller--horizontal,
.unity-scroller.unity-scroller--horizontal {
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    background-color: transparent;
    border-width: 0;
    margin-bottom: 12px;
    margin-left: 8px;
    margin-right: 8px;
    position: relative;
}

/* Arrow Buttons (Low / High buttons) - Strictly Positioned at Extremes */
.unity-scroller--vertical > .unity-scroller__low-button,
.unity-scroller--vertical #unity-low-button,
#survey-scroll-view .unity-scroller--vertical #unity-low-button {
    position: absolute;
    top: 0;
    left: 1px;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    max-width: 18px;
    max-height: 18px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-up.png?fileID=2800000&guid=13e6e2a9f27e5874eab92e305adb3fa1&type=3#chevron-up");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(103, 80, 164, 0.6);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.unity-scroller--vertical > .unity-scroller__low-button:hover,
.unity-scroller--vertical #unity-low-button:hover {
    -unity-background-image-tint-color: var(--primary-color);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--vertical > .unity-scroller__low-button:active,
.unity-scroller--vertical #unity-low-button:active {
    -unity-background-image-tint-color: var(--primary-hover);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--vertical > .unity-scroller__low-button > VisualElement,
.unity-scroller--vertical #unity-low-button > VisualElement {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

.unity-scroller--vertical > .unity-scroller__high-button,
.unity-scroller--vertical #unity-high-button,
#survey-scroll-view .unity-scroller--vertical #unity-high-button {
    position: absolute;
    bottom: 0;
    left: 1px;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    max-width: 18px;
    max-height: 18px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-down.png?fileID=2800000&guid=d1a74cec442a2284589bab0730540f72&type=3#chevron-down");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(103, 80, 164, 0.6);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.unity-scroller--vertical > .unity-scroller__high-button:hover,
.unity-scroller--vertical #unity-high-button:hover {
    -unity-background-image-tint-color: var(--primary-color);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--vertical > .unity-scroller__high-button:active,
.unity-scroller--vertical #unity-high-button:active {
    -unity-background-image-tint-color: var(--primary-hover);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--vertical > .unity-scroller__high-button > VisualElement,
.unity-scroller--vertical #unity-high-button > VisualElement {
    display: none;
    width: 0;
    height: 0;
    opacity: 0;
}

/* Horizontal Arrow Buttons */
.unity-scroller--horizontal > .unity-scroller__low-button,
.unity-scroller--horizontal #unity-low-button {
    position: absolute;
    left: 0;
    top: 1px;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-left.png?fileID=2800000&guid=4ab49af5e05cd304a88ca8241e489d55&type=3#chevron-left");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(103, 80, 164, 0.6);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--horizontal > .unity-scroller__high-button,
.unity-scroller--horizontal #unity-high-button {
    position: absolute;
    right: 0;
    top: 1px;
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-right.png?fileID=2800000&guid=05c0e935411a9e64383e2a9a89216d33&type=3#chevron-right");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(103, 80, 164, 0.6);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-scroller--horizontal > .unity-scroller__low-button > VisualElement,
.unity-scroller--horizontal #unity-low-button > VisualElement,
.unity-scroller--horizontal > .unity-scroller__high-button > VisualElement,
.unity-scroller--horizontal #unity-high-button > VisualElement {
    display: none;
}

/* Scroller Slider Container (Bounded strictly between the arrow buttons) */
.unity-scroller--vertical .unity-slider,
.unity-scroller--vertical .unity-scroller__slider,
.unity-scroller--vertical #unity-slider,
#survey-scroll-view .unity-scroller--vertical #unity-slider {
    position: absolute;
    top: 22px;
    bottom: 22px;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
    width: 20px;
    min-width: 20px;
    max-width: 20px;
}

.unity-scroller--horizontal .unity-slider,
.unity-scroller--horizontal .unity-scroller__slider,
.unity-scroller--horizontal #unity-slider {
    position: absolute;
    left: 22px;
    right: 22px;
    top: 0;
    bottom: 0;
    height: 20px;
    min-height: 20px;
    margin: 0;
    padding: 0;
    background-color: transparent;
    border-width: 0;
}

.unity-scroller .unity-base-slider__drag-container,
.unity-scroller #unity-drag-container {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

/* Tracker / Track Background */
.unity-scroller--vertical .unity-base-slider__tracker,
.unity-scroller--vertical .unity-scroller__tracker,
.unity-scroller--vertical #unity-tracker,
#survey-scroll-view .unity-scroller--vertical #unity-tracker {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 3px;
    right: 3px;
    width: 14px;
    min-width: 14px;
    max-width: 14px;
    background-color: rgba(103, 80, 164, 0.08);
    border-width: 0;
    border-radius: 7px;
    margin: 0;
    padding: 0;
}

.unity-scroller--horizontal .unity-base-slider__tracker,
.unity-scroller--horizontal #unity-tracker {
    position: absolute;
    left: 0;
    right: 0;
    top: 3px;
    bottom: 3px;
    height: 14px;
    min-height: 14px;
    background-color: rgba(103, 80, 164, 0.08);
    border-width: 0;
    border-radius: 7px;
    margin: 0;
    padding: 0;
}

/* Dragger / Thumb (Wide Rounded Pill) */
.unity-scroller--vertical .unity-base-slider__dragger,
.unity-scroller--vertical .unity-scroller__dragger,
.unity-scroller--vertical #unity-dragger,
#survey-scroll-view .unity-scroller--vertical #unity-dragger {
    position: absolute;
    left: 3px;
    width: 14px;
    min-width: 14px;
    max-width: 14px;
    min-height: 28px;
    background-color: rgba(103, 80, 164, 0.42);
    border-width: 0;
    border-radius: 7px;
    margin: 0;
    padding: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover,
.unity-scroller--vertical #unity-dragger:hover {
    background-color: rgba(103, 80, 164, 0.65);
}

.unity-scroller--vertical .unity-base-slider__dragger:active,
.unity-scroller--vertical #unity-dragger:active {
    background-color: var(--primary-color);
}

.unity-scroller--horizontal .unity-base-slider__dragger,
.unity-scroller--horizontal #unity-dragger {
    position: absolute;
    top: 3px;
    height: 14px;
    min-height: 14px;
    min-width: 28px;
    background-color: rgba(103, 80, 164, 0.42);
    border-width: 0;
    border-radius: 7px;
    margin: 0;
    padding: 0;
}

.unity-scroller .unity-base-slider__dragger-border,
.unity-scroller .unity-scroller__dragger-border,
.unity-scroller #unity-dragger-border {
    display: none;
    border-width: 0;
    background-color: transparent;
}

/* ==========================================================================
   DROPDOWN MENU / POPUP STYLING (GenericDropdownMenu & BasePopupField)
   ========================================================================== */

/* Outer Popup Container */
.unity-base-dropdown,
.unity-base-dropdown-menu,
GenericDropdownMenu,
#unity-base-dropdown {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
    overflow: visible;
}

.unity-base-dropdown__container-outer,
.unity-base-dropdown-menu__container-outer {
    background-color: rgb(255, 255, 255);
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
    padding: 4px;
    margin-top: 4px;
    overflow: hidden;
}

.unity-base-dropdown__container-inner,
.unity-base-dropdown-menu__container-inner {
    background-color: transparent;
    border-width: 0;
    padding: 0;
}

.unity-base-dropdown__scroll-view,
.unity-base-dropdown-menu__scroll-view {
    background-color: transparent;
    max-height: 240px;
}

/* Individual Dropdown Item (Left-Aligned Clean Text) */
.unity-base-dropdown__item,
.unity-base-dropdown-menu__item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    min-height: 32px;
    height: 32px;
    padding-left: 14px;
    padding-right: 14px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 8px;
    background-color: transparent;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.unity-base-dropdown__item:hover,
.unity-base-dropdown-menu__item:hover {
    background-color: rgb(246, 230, 255);
}

.unity-base-dropdown__item:checked,
.unity-base-dropdown-menu__item:checked,
.unity-base-dropdown__item--selected,
.unity-base-dropdown-menu__item--selected {
    background-color: rgb(247, 242, 250);
}

/* Hide Checkmarks Completely */
.unity-base-dropdown__item-checkmark,
.unity-base-dropdown-menu__item-checkmark,
.unity-base-dropdown__checkmark,
.unity-base-dropdown-menu__checkmark,
.unity-base-dropdown .unity-base-dropdown__item-checkmark,
.unity-base-dropdown-menu .unity-base-dropdown-menu__item-checkmark {
    display: none;
    width: 0;
    height: 0;
    min-width: 0;
    min-height: 0;
    max-width: 0;
    max-height: 0;
    margin-right: 0;
    margin-left: 0;
    margin-top: 0;
    margin-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    visibility: hidden;
}

.unity-base-dropdown__item-content,
.unity-base-dropdown-menu__item-content {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    margin: 0;
    padding: 0;
}

/* Item Text / Label (Left-aligned) */
.unity-base-dropdown__item-text,
.unity-base-dropdown-menu__item-text,
.unity-base-dropdown__label,
.unity-base-dropdown-menu__label,
.unity-base-dropdown .unity-label,
.unity-base-dropdown-menu .unity-label,
.unity-base-dropdown TextElement,
.unity-base-dropdown-menu TextElement {
    color: rgb(29, 25, 43);
    font-size: 13px;
    -unity-font-style: normal;
    -unity-text-align: middle-left;
    text-align: left;
    align-self: center;
    margin-left: 0;
    padding-left: 0;
}

.unity-base-dropdown__item:hover .unity-base-dropdown__item-text,
.unity-base-dropdown__item:hover .unity-base-dropdown__label,
.unity-base-dropdown__item:hover .unity-label,
.unity-base-dropdown__item:hover TextElement,
.unity-base-dropdown-menu__item:hover TextElement {
    color: rgb(103, 80, 164);
}

.unity-base-dropdown__item:checked .unity-base-dropdown__item-text,
.unity-base-dropdown__item:checked .unity-base-dropdown__label,
.unity-base-dropdown__item:checked .unity-label,
.unity-base-dropdown__item:checked TextElement,
.unity-base-dropdown__item--selected .unity-base-dropdown__item-text,
.unity-base-dropdown__item--selected .unity-base-dropdown__label,
.unity-base-dropdown__item--selected .unity-label,
.unity-base-dropdown__item--selected TextElement,
.unity-base-dropdown-menu__item:checked TextElement,
.unity-base-dropdown-menu__item--selected TextElement {
    color: rgb(103, 80, 164);
    -unity-font-style: bold;
}

/* Dropdown Separator */
.unity-base-dropdown__separator,
.unity-base-dropdown-menu__separator {
    height: 1px;
    background-color: rgba(103, 80, 164, 0.12);
    margin-top: 4px;
    margin-bottom: 4px;
}

#survey-first-page {
    flex-grow: 1;
    min-height: 100%;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 32px;
}

#survey-first-page #survey-title {
    -unity-text-align: middle-center;
    font-size: 22px;
    margin-bottom: 16px;
}

#survey-first-page #question-description {
    -unity-text-align: middle-center;
    font-size: 15px;
    margin-bottom: 20px;
}

#survey-thank-you-page {
    flex-grow: 1;
    min-height: 100%;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: 100%;
    padding-left: 28px;
    padding-right: 28px;
    padding-top: 32px;
    padding-bottom: 32px;
}

#thank-you-icon {
    width: 64px;
    height: 64px;
    margin-bottom: 20px;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/icons8-survey-96.png?fileID=2800000&guid=e4cbf49ef86a87f4e8d7f185fd605cf8&type=3#icons8-survey-96");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--primary-color);
}

#thank-you-title {
    -unity-text-align: middle-center;
    font-size: 22px;
    -unity-font-style: bold;
    color: var(--dark-text);
    margin-bottom: 12px;
    white-space: normal;
}

#thank-you-description {
    -unity-text-align: middle-center;
    font-size: 15px;
    color: var(--muted-text);
    margin-bottom: 28px;
    white-space: normal;
}

.thank-you-btn {
    height: 42px;
    min-width: 160px;
    padding-left: 24px;
    padding-right: 24px;
    border-radius: 21px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    font-size: 15px;
    -unity-font-style: bold;
    align-items: center;
    justify-content: center;
    border-width: 0;
}

.thank-you-btn:hover {
    background-color: rgb(83, 62, 140);
}

#bottom-bar,
.viewer-bottom-bar {
    position: relative;
    bottom: auto;
    right: auto;
    left: auto;
    top: auto;
    width: 100%;
    height: 64px;
    flex-grow: 0;
    flex-shrink: 0;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 20px;
    padding-right: 20px;
    border-top-width: 1px;
    border-top-color: var(--border-color);
    background-color: rgb(250, 250, 250);
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

.nav-btn {
    width: 40px;
    height: 40px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    border-width: 0;
    padding: 0;
    margin: 0;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
    background-size: 55% 55%;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#previous-btn {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-left.png?fileID=2800000&guid=4ab49af5e05cd304a88ca8241e489d55&type=3#chevron-left");
    background-color: rgb(240, 240, 240);
}

#previous-btn:hover {
    background-color: rgb(228, 228, 228);
}

#next-btn {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-right.png?fileID=2800000&guid=05c0e935411a9e64383e2a9a89216d33&type=3#chevron-right");
    background-color: var(--primary-color);
    -unity-background-image-tint-color: rgb(255, 255, 255);
}

#next-btn:hover {
    background-color: rgb(83, 62, 140);
}

#next-btn.submit-btn {
    width: auto;
    min-width: 100px;
    height: 40px;
    padding-left: 18px;
    padding-right: 18px;
    border-top-left-radius: 20px;
    border-top-right-radius: 20px;
    border-bottom-left-radius: 20px;
    border-bottom-right-radius: 20px;
    background-image: none;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
}

#next-btn.submit-btn:hover {
    background-color: rgb(83, 62, 140);
    color: rgb(255, 255, 255);
}

#next-btn.submit-btn:active {
    background-color: rgb(65, 45, 120);
    color: rgb(255, 255, 255);
}

#page-count-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--muted-text);
    -unity-text-align: middle-center;
}

#toggle-btn {
    width: 32px;
    height: 32px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    align-items: center;
    justify-content: center;
    padding: 0;
    margin: 0;
