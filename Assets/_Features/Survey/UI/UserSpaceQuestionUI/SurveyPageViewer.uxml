<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SurveyTitleBar" src="project://database/Assets/_Features/Survey/UI/UserSpaceQuestionUI/SurveyTitleBar.uxml?fileID=9197481963319205126&amp;guid=a6a65ecf5890a104cad2a0fa134a14d3&amp;type=3#SurveyTitleBar" />
    <Style src="project://database/Assets/_Features/Survey/UI/UserSpaceQuestionUI/UserStyles.uss?fileID=7433441132597879392&amp;guid=74558b2425df4b44db13d07e45d34b9f&amp;type=3#UserStyles" />
    <ui:VisualElement name="page-container" style="min-width: 420px; width: 25%; max-width: 600px;">
        <ui:VisualElement name="header-container">
            <ui:VisualElement style="flex-direction: row; align-items: center;">
                <ui:VisualElement name="header-icon" />
                <ui:Label text="Stránka průzkumu" name="title" />
            </ui:VisualElement>
            <ui:Button name="toggle-btn" />
        </ui:VisualElement>
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Auto" name="survey-scroll-view" picking-mode="Ignore">
            <ui:Instance template="SurveyTitleBar" style="flex-grow: 1; width: 100%;" />
        </ui:ScrollView>
        <ui:VisualElement name="bottom-bar">
            <ui:Button name="previous-btn" class="nav-btn" />
            <ui:Label text="999/999" name="page-count-label" />
            <ui:Button name="next-btn" class="nav-btn" style="background-color: rgb(240, 240, 240);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
