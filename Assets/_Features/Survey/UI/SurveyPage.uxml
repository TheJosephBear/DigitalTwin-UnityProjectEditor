<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="SurveyTitleBar" src="project://database/Assets/_Features/Survey/UI/SurveyTitleBar.uxml?fileID=9197481963319205126&amp;guid=c2b63055578686f41baea2448e3ef7d5&amp;type=3#SurveyTitleBar" />
    <ui:Template name="AddQuestionBar" src="project://database/Assets/_Features/Survey/UI/AddQuestionBar.uxml?fileID=9197481963319205126&amp;guid=c099ff1d780c64e4193d328bc2f6bc01&amp;type=3#AddQuestionBar" />
    <ui:Template name="Checkboxes" src="project://database/Assets/_Features/Survey/UI/QuestionTypes/Checkboxes.uxml?fileID=9197481963319205126&amp;guid=e497a4432c94ffe4f913e5d17da72d2a&amp;type=3#Checkboxes" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="page-container" class="page-container" style="flex-grow: 1; background-color: rgb(251, 248, 253);">
        <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="AlwaysVisible" name="survey-scroll-view" style="flex-grow: 1;">
            <ui:Instance template="SurveyTitleBar" />
            <ui:Instance template="AddQuestionBar" />
            <ui:Instance template="Checkboxes" name="TemplateContainer" class="active-question" />
            <ui:Instance template="AddQuestionBar" />
        </ui:ScrollView>
        <ui:VisualElement name="bottom-bar">
            <ui:Button name="save-btn" class="icon" tooltip="Uložit dotazník" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/content-save.png?fileID=2800000&amp;guid=42b65eea87b5f604fbc3255670ad5b51&amp;type=3#content-save&quot;);" />
            <ui:Button name="exit-btn" class="icon" tooltip="Ukončit" style="background-image: url(&quot;project://database/Assets/_Features/Survey/UI/Icons/exit-to-app.png?fileID=2800000&amp;guid=268ab040285f4644aacd7fed523d06d8&amp;type=3#exit-to-app&quot;);" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
