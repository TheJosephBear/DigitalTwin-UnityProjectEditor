<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="EditOptionModal" src="project://database/Assets/_Features/Survey/UI/EditOptionModal.uxml?fileID=9197481963319205126&amp;guid=76703d756520966448429ac694633d27&amp;type=3#EditOptionModal" />
    <Style src="project://database/Assets/_Features/Survey/UI/Styles.uss?fileID=7433441132597879392&amp;guid=e2857671203a4094b98524b8aefbd78f&amp;type=3#Styles" />
    <ui:VisualElement name="option-container" class="scale-row-container">
        <ui:TextField placeholder-text="Text položky" name="scale-row-text" multiline="false" style="flex-grow: 1; flex-shrink: 1; min-width: 140px; margin-right: 12px; max-width: 250px;" />
        <ui:VisualElement name="scale-preview" class="scale-preview-container" style="flex-grow: 3;">
            <ui:Label name="scale-min-label" text="1" class="scale-limit-label" />
            <ui:SliderInt name="scale-slider-preview" low-value="1" high-value="5" value="1" class="scale-slider" />
            <ui:Label name="scale-max-label" text="5" class="scale-limit-label" />
        </ui:VisualElement>
        <ui:Instance template="EditOptionModal" />
    </ui:VisualElement>
</ui:UXML>
