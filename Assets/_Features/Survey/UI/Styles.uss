.scale-value-badge {
    min-width: 32px;
    height: 28px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 12px;
}

#bottom-bar {
    position: absolute;
    bottom: 24px;
    right: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}

.floating-bottom-bar {
    position: absolute;
    bottom: 24px;
    right: 42px;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin: 0;
}

#bottom-bar #exit-btn {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    border-radius: 21px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.25);
    padding: 0;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    scale: 1 1;
}

.floating-fab-secondary {
    width: 42px;
    height: 42px;
    min-width: 42px;
    min-height: 42px;
    border-radius: 21px;
    background-color: rgb(255, 255, 255);
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.25);
    padding: 0;
    margin-right: 12px;
    justify-content: center;
    align-items: center;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: background-color, border-color, scale;
    transition-duration: 0.15s;
    scale: 1 1;
}

#bottom-bar #exit-btn:hover {
    background-color: var(--primary-background-color);
    border-color: var(--primary-color);
    scale: 1.08 1.08;
}

.floating-fab-secondary:hover {
    background-color: var(--primary-background-color);
    border-color: var(--primary-color);
    scale: 1.08 1.08;
}

#bottom-bar #exit-btn:active {
    background-color: var(--secondary-background-color);
    scale: 0.95 0.95;
}

.floating-fab-secondary:active {
    background-color: var(--secondary-background-color);
    scale: 0.95 0.95;
}

.floating-fab-exit-icon {
    width: 20px;
    height: 20px;
    min-width: 20px;
    min-height: 20px;
    -unity-background-image-tint-color: rgb(98, 91, 113);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

#bottom-bar #exit-btn:hover .floating-fab-exit-icon {
    -unity-background-image-tint-color: var(--primary-color);
}

.floating-fab-secondary:hover .floating-fab-exit-icon {
    -unity-background-image-tint-color: var(--primary-color);
}

#bottom-bar #save-btn {
    height: 42px;
    min-height: 42px;
    padding-left: 18px;
    padding-right: 20px;
    border-radius: 21px;
    background-color: var(--primary-color);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: background-color, scale;
    transition-duration: 0.15s;
    scale: 1 1;
}

.floating-fab-primary {
    height: 42px;
    min-height: 42px;
    padding-left: 18px;
    padding-right: 20px;
    border-radius: 21px;
    background-color: var(--primary-color);
    border-width: 0;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: background-color, scale;
    transition-duration: 0.15s;
    scale: 1 1;
}

#bottom-bar #save-btn:hover {
    background-color: var(--primary-hover);
    scale: 1.06 1.06;
}

.floating-fab-primary:hover {
    background-color: var(--primary-hover);
    scale: 1.06 1.06;
}

#bottom-bar #save-btn:active {
    background-color: rgb(73, 50, 125);
    scale: 0.96 0.96;
}

.floating-fab-primary:active {
    background-color: rgb(73, 50, 125);
    scale: 0.96 0.96;
}

.floating-fab-save-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
    flex-shrink: 0;
}

#bottom-bar #save-btn .floating-fab-save-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
    flex-shrink: 0;
}

#save-btn .floating-fab-save-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-background-scale-mode: scale-to-fit;
    margin-right: 8px;
    flex-shrink: 0;
}

.floating-fab-save-label {
    color: rgb(255, 255, 255);
    font-size: 13.5px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
}

.question-selection-popup {
    width: 250px;
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
    padding: 6px;
    margin: 0;
}

#question-selection-container {
    width: 250px;
    background-color: rgb(255, 255, 255);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(103, 80, 164, 0.2);
    padding: 6px;
    margin: 0;
}

.question-selection-header {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    padding-top: 4px;
    padding-bottom: 2px;
    padding-left: 8px;
    padding-right: 8px;
}

.question-selection-header-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: var(--primary-color);
    letter-spacing: 0.5px;
    margin: 0;
    padding: 0;
}

.question-selection-divider {
    height: 1px;
    background-color: var(--card-border);
    margin-top: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    margin-right: 4px;
}

.question-selection-subdivider {
    height: 1px;
    background-color: rgba(232, 224, 236, 0.7);
    margin-top: 3px;
    margin-bottom: 3px;
    margin-left: 6px;
    margin-right: 6px;
}

.question-selection-list {
    flex-direction: column;
}

.question-selection-item {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 38px;
    min-height: 38px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    margin-top: 1px;
    margin-bottom: 1px;
    border-radius: 8px;
    border-width: 0;
    background-color: transparent;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
    transition-property: background-color, scale;
    transition-duration: 0.12s;
    scale: 1 1;
}

.question-selection-item:hover {
    background-color: var(--secondary-background-color);
    scale: 1.015 1.015;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.question-selection-item:active {
    background-color: var(--primary-background-color);
    scale: 0.985 0.985;
}

.question-selection-item-icon-box {
    width: 28px;
    height: 28px;
    min-width: 28px;
    min-height: 28px;
    border-radius: 6px;
    background-color: var(--primary-background-color);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
    flex-shrink: 0;
    transition-property: background-color;
    transition-duration: 0.12s;
}

.question-selection-item:hover .question-selection-item-icon-box {
    background-color: rgb(238, 222, 252);
}

.question-selection-item-icon {
    width: 18px;
    height: 18px;
    min-width: 18px;
    min-height: 18px;
    -unity-background-image-tint-color: var(--primary-color);
    -unity-background-scale-mode: scale-to-fit;
}

.question-selection-item-title {
    font-size: 13.5px;
    -unity-font-style: bold;
    color: var(--text-main);
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
    flex-grow: 1;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.12s;
}

.question-selection-item:hover .question-selection-item-title {
    color: var(--primary-color);
}

#tooltipLabel {
    position: absolute;
    background-color: rgb(32, 26, 44);
    color: rgb(255, 255, 255);
    border-radius: 7px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: normal;
    white-space: normal;
    max-width: 250px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    display: none;
    -unity-text-align: middle-left;
}

.custom-tooltip-label {
    position: absolute;
    background-color: rgb(32, 26, 44);
    color: rgb(255, 255, 255);
    border-radius: 7px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    font-size: 12px;
    -unity-font-style: normal;
    white-space: normal;
    max-width: 250px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    display: none;
    -unity-text-align: middle-left;
}
