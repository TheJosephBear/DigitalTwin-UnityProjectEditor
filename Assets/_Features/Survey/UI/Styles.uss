#add-buttons {
    margin-top: 8px;
    flex-direction: row;
    align-items: center;
}

.enhance-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.remove-button {
    background-color: rgba(255, 255, 255, 0.6);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.enhance-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.15 1.15;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.remove-button:hover {
    background-color: rgba(255, 255, 255, 0.95);
    scale: 1.15 1.15;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.enhance-button:active {
    background-color: rgb(220, 220, 220);
    scale: 0.95 0.95;
}

.remove-button:active {
    background-color: rgb(220, 220, 220);
    scale: 0.95 0.95;
}

.scale-config-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 12px;
    border-radius: 6px;
}

.scale-config-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    margin-right: 8px;
}

.scale-type-dropdown {
    width: 140px;
    height: 32px;
}

.scale-options-list {
    flex-direction: column;
    width: 100%;
}

.scale-row-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.scale-preview-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 200px;
    margin-right: 8px;
}

.scale-limit-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    min-width: 24px;
    -unity-text-align: middle-center;
}

.scale-slider {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
}

.scale-slider .unity-base-slider__dragger {
    background-color: var(--primary-color);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
}

#unity-dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-base-slider__dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-base-slider__dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.unity-base-slider__dragger:active {
