}

.scale-slider {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider.is-dragging * {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider #unity-dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__dragger:focus {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__drag-container {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider .unity-base-slider__tracker {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.scale-slider {
    overflow: visible;
}

.scale-slider .unity-base-slider__dragger {
    overflow: visible;
}

.scale-slider .unity-base-slider__drag-container {
    overflow: visible;
}

.scale-slider .unity-base-slider__tracker {
    overflow: visible;
}

.scale-dragger-tooltip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
    white-space: nowrap;
}

#unity-dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:focus .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-slider.is-dragging .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-dragger-tooltip.is-dragging {
    opacity: 1;
    scale: 1 1;
}

.scale-slider .unity-base-slider__tracker {
    background-color: rgba(103, 80, 164, 0.25);
    height: 6px;
    border-radius: 3px;
}

.add-scale-row-btn {
    width: 150px;
    height: 32px;
    align-items: center;
    justify-content: center;
}

.scale-viewer-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
}

.scale-viewer-row-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(40, 40, 40);
    min-width: 160px;
    max-width: 250px;
    flex-shrink: 0;
    white-space: normal;
}

.scale-value-badge {
    min-width: 32px;
    height: 28px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 12px;
}
