.icon-trash {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/trash-can-outline.png?fileID=2800000&guid=7ad15b4efd0e279438b167e4bed1c7e6&type=3#trash-can-outline");
    -unity-background-scale-mode: scale-to-fit;
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-background-image-tint-color: rgb(150, 145, 160);
    transition-property: background-color, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.icon-trash:hover {
    background-color: rgb(254, 242, 242);
    -unity-background-image-tint-color: rgb(220, 38, 38);
    opacity: 1;
}

.icon-move-up {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-up.png?fileID=2800000&guid=13e6e2a9f27e5874eab92e305adb3fa1&type=3#chevron-up");
    -unity-background-scale-mode: scale-to-fit;
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-background-image-tint-color: rgb(150, 145, 160);
    transition-property: background-color, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.icon-move-up:hover {
    background-color: var(--primary-background-color);
    -unity-background-image-tint-color: var(--primary-color);
    opacity: 1;
}

.icon-move-up:disabled {
    opacity: 0.25;
}

.icon-move-down {
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/chevron-down.png?fileID=2800000&guid=d1a74cec442a2284589bab0730540f72&type=3#chevron-down");
    -unity-background-scale-mode: scale-to-fit;
    width: 28px;
    height: 28px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    margin-left: 2px;
    margin-right: 2px;
    -unity-background-image-tint-color: rgb(150, 145, 160);
    transition-property: background-color, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

.icon-move-down:hover {
    background-color: var(--primary-background-color);
    -unity-background-image-tint-color: var(--primary-color);
    opacity: 1;
}

.icon-move-down:disabled {
    opacity: 0.25;
}

#add-buttons,
.add-buttons {
    margin-top: 12px;
    margin-left: 56px;
    margin-right: 386px;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

#add-buttons Button,
.add-buttons Button {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    height: 34px;
    padding-left: 12px;
    padding-right: 12px;
    border-radius: 12px;
    background-color: var(--primary-background-color);
    color: var(--primary-color);
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
    margin-right: 0;
}

#add-buttons #add-option-button,
.add-buttons #add-option-button {
    margin-right: 8px;
    margin-left: 0;
}

#add-buttons #add-other-option-button,
.add-buttons #add-other-option-button {
    margin-left: 8px;
    margin-right: 0;
}

#add-buttons Button:hover,
.add-buttons Button:hover,
#add-row-button:hover,
#add-column-button:hover {
    background-color: var(--secondary-background-color);
}

#add-row-button,
#add-column-button {
    height: 34px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 12px;
    background-color: var(--primary-background-color);
    color: var(--primary-color);
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.add-question-bar {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
    margin-bottom: 14px;
    height: 36px;
    justify-content: center;
}

.add-question-divider-line {
    flex-grow: 1;
    height: 1px;
    background-color: rgb(73, 69, 79);
    transition-property: background-color;
    transition-duration: 0.15s;
}

.add-question-bar:hover .add-question-divider-line {
    background-color: var(--primary-color);
}

.add-question-button,
#add-question-button {
    width: 32px;
    height: 32px;
    min-width: 32px;
    min-height: 32px;
    max-width: 32px;
    max-height: 32px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgb(73, 69, 79);
    background-color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgb(29, 25, 43);
    -unity-background-scale-mode: scale-to-fit;
    transition-property: background-color, border-color, -unity-background-image-tint-color, scale;
    transition-duration: 0.15s;
    scale: 1 1;
    margin-left: 0;
    margin-right: 0;
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
}

.add-question-bar:hover .add-question-button,
.add-question-bar:hover #add-question-button,
.add-question-button:hover,
#add-question-button:hover {
    scale: 1.08 1.08;
    background-color: var(--primary-background-color);
    border-color: var(--primary-color);
    -unity-background-image-tint-color: var(--primary-color);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.enhance-button {
    background-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-width: 0;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.remove-button {
    background-color: rgba(255, 255, 255, 0.85);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-width: 0;
    transition-duration: 0.15s;
    transition-property: background-color, scale;
}

.enhance-button:hover {
    background-color: rgb(255, 255, 255);
    scale: 1.1 1.1;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.remove-button:hover {
    background-color: rgb(255, 255, 255);
    scale: 1.1 1.1;
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.enhance-button:active {
    background-color: rgb(240, 240, 240);
    scale: 0.95 0.95;
}

.remove-button:active {
    background-color: rgb(240, 240, 240);
    scale: 0.95 0.95;
}

.scale-config-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
    padding: 6px 12px;
    border-radius: 6px;
}

.scale-config-label {
    font-size: 14px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    margin-right: 8px;
}

.scale-type-dropdown {
    width: 140px;
    height: 32px;
}

.scale-options-list {
    flex-direction: column;
    width: 100%;
}

.scale-row-container {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 4px;
    margin-bottom: 4px;
    padding: 4px 6px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(0, 0, 0, 0.06);
}

.scale-preview-container {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-shrink: 0;
    min-width: 200px;
    margin-right: 8px;
}

.scale-limit-label {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--secondary-color);
    min-width: 24px;
    -unity-text-align: middle-center;
}

.scale-slider {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 6px;
}

.scale-slider .unity-base-slider__dragger {
    background-color: var(--primary-color);
    border-radius: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
}

#unity-dragger {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:active {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

#unity-dragger:focus {
