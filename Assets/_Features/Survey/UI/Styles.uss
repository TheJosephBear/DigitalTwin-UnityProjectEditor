:root {
    --primary-color: rgb(103, 80, 164);
    --secondary-color: rgb(73, 62, 105);
    --primary-background-color: rgb(247, 242, 250);
    --secondary-background-color: rgb(246, 230, 255);
}

#survey-scroll-view #unity-content-container {
    padding-top: 30px;
    padding-right: 10%;
    padding-bottom: 20px;
    padding-left: 10%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#survey-scroll-view .unity-scroll-view__content-container {
    padding-top: 20px;
    padding-right: 10%;
    padding-bottom: 20px;
    padding-left: 10%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.question-type-selection {
    position: absolute;
    left: 50%;
    top: 25px;
}

RadioButton > Label {
    flex-grow: 1;
    flex-shrink: 0;
}

RadioButton > VisualElement {
    flex-shrink: 1;
    max-width: 24px;
    min-width: 24px;
    width: 24px;
}

Toggle > Label {
    flex-grow: 1;
    flex-shrink: 0;
}

Toggle > VisualElement {
    flex-shrink: 1;
    max-width: 24px;
    min-width: 24px;
    width: 24px;
    margin-right: 8px;
}

RadioButtonGroup > VisualElement {
    align-self: center;
    justify-content: center;
    background-color: initial;
}

RadioButtonGroup > VisualElement:hover {
    background-color: initial;
}

RadioButtonGroup > VisualElement:focus {
    background-color: initial;
}

RadioButtonGroup #contentContainer {
    flex-direction: column;
    flex-wrap: nowrap;
    width: 100%;
    justify-content: flex-start;
}

RadioButtonGroup TemplateContainer {
}

#option-container {
    flex-grow: 0;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.option-container--other {
    background-color: rgba(103, 80, 164, 0.04);
    border-radius: 8px;
    padding-left: 0;
    padding-right: 0;
}

#edit-option-button {
    flex-grow: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/dots-vertical.png?fileID=2800000&guid=2040f2cd9ea79384fa550b86e042f01b&type=3#dots-vertical");
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    align-self: center;
}

#edit-col-button {
    flex-grow: 0;
    background-image: url("project://database/Assets/_Features/Survey/UI/Icons/dots-horizontal.png?fileID=2800000&guid=e1ed4ee9247a04641bef93df4c77be7d&type=3#dots-horizontal");
    width: 32px;
    height: 26px;
    -unity-background-scale-mode: scale-and-crop;
    margin-right: 0;
    align-self: center;
    align-content: flex-end;
    align-items: flex-end;
    margin-top: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.radio_no-margin > VisualElement {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.radio-group-vertical #contentContainer {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
}

.radio-group-grid #contentContainer {
    justify-content: space-around;
    align-items: center;
    flex-direction: row;
    flex-grow: 0;
    flex-shrink: 0;
    width: 100%;
}

Button {
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-left-radius: 8px;
    background-color: var(--primary-background-color);
    color: var(--primary-color);
}

Button:hover {
    background-color: var(--secondary-background-color);
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

Button VisualElement:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

Button Label:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

Button.icon {
    width: 32px;
    height: 32px;
    -unity-background-scale-mode: scale-to-fit;
    background-color: rgba(0, 0, 0, 0);
}

Button.icon:hover {
    background-color: rgb(247, 242, 250);
}

Button.icon:disabled {
    opacity: 0.3;
    background-color: rgba(0, 0, 0, 0);
}

TextField TextElement:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/ibeam_32thin.png?fileID=2800000&guid=02d5e55818938834894e19a703e94dab&type=3#ibeam_32thin") 16 16;
}

TextField TextInput {
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgb(255, 255, 255);
}

TextField TextInput:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/ibeam_32thin.png?fileID=2800000&guid=02d5e55818938834894e19a703e94dab&type=3#ibeam_32thin") 16 16;
}

.question-wrapper {
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    margin-top: 6px;
    margin-bottom: 6px;
}

.question-move-controls {
    flex-direction: column;
    justify-content: center;
    align-items: center;
    width: 36px;
    margin-right: 8px;
    padding-top: 12px;
    padding-bottom: 12px;
    flex-shrink: 0;
}

.question-move-controls .icon-move-up,
.question-move-controls .icon-move-down {
    width: 28px;
    height: 28px;
    margin-top: 2px;
    margin-bottom: 2px;
}

.question-container,
#question-container {
    flex-grow: 1;
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: rgba(103, 80, 164, 0.15);
    border-right-color: rgba(103, 80, 164, 0.15);
    border-bottom-color: rgba(103, 80, 164, 0.15);
    border-left-color: rgba(103, 80, 164, 0.15);
    padding-top: 20px;
    padding-right: 24px;
    padding-bottom: 20px;
    padding-left: 24px;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.question-container:hover,
#question-container:hover {
    border-top-color: rgba(103, 80, 164, 0.45);
    border-right-color: rgba(103, 80, 164, 0.45);
    border-bottom-color: rgba(103, 80, 164, 0.45);
    border-left-color: rgba(103, 80, 164, 0.45);
}

TemplateContainer.active-question,
.question-wrapper.active-question,
.active-question {
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
}

.active-question > .question-wrapper > .question-container,
.active-question > .question-container,
.active-question .question-container,
.active-question #question-container,
.question-wrapper.active-question .question-container,
.question-container.active-question {
    border-top-color: var(--primary-color);
    border-right-color: var(--primary-color);
    border-bottom-color: var(--primary-color);
    border-left-color: var(--primary-color);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
}

.survey-header-card {
    background-color: rgb(255, 255, 255);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    border-bottom-right-radius: 18px;
    border-bottom-left-radius: 18px;
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-top-color: rgba(103, 80, 164, 0.15);
    border-right-color: rgba(103, 80, 164, 0.15);
    border-bottom-color: rgba(103, 80, 164, 0.15);
    border-left-color: rgba(103, 80, 164, 0.15);
    padding-top: 20px;
    padding-right: 24px;
    padding-bottom: 20px;
    padding-left: 24px;
    margin-bottom: 8px;
}

.question-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 8px;
}

.question-row-actions {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    width: 280px;
    flex-shrink: 0;
}

.edit-option-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    width: 280px;
    flex-shrink: 0;
}

.required-container {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-shrink: 0;
}

.required-label {
    font-size: 13px;
    color: rgb(110, 110, 110);
    margin-right: 8px;
    white-space: nowrap;
    -unity-font-style: normal;
}

.required-label:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

/* Switch Pill (Toggle) */
.switch-pill {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.switch-pill .unity-toggle__label {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

.switch-pill .unity-toggle__input {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    background-color: rgb(225, 220, 230);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    position: relative;
    overflow: hidden;
    transition-property: background-color;
    transition-duration: 0.18s;
}

.switch-pill .unity-toggle__checkmark {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    position: absolute;
    top: 2px;
    left: 2px;
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: left, background-color;
    transition-duration: 0.18s;
}

.switch-pill:checked .unity-toggle__input {
    background-color: var(--primary-color);
}

.switch-pill:checked .unity-toggle__checkmark,
.switch-pill:checked > .unity-toggle__input > .unity-toggle__checkmark {
    left: 22px;
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.switch-pill:hover,
.switch-pill .unity-toggle__input:hover {
    cursor: url("project://database/Assets/_Features/Survey/UI/Icons/hand_32.png?fileID=2800000&guid=1b4075f7f88528c4186bf33a5f7161a0&type=3#hand_32");
}

.question-section-spacer {
    height: 14px;
    flex-shrink: 0;
}

