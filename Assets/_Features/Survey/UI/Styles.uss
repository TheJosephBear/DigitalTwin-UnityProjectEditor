    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    justify-content: center;
    align-items: center;
    flex-shrink: 0;
}

.switch-pill .unity-toggle__label {
    display: none;
    width: 0;
    height: 0;
    margin: 0;
    padding: 0;
}

.switch-pill .unity-toggle__input {
    width: 44px;
    min-width: 44px;
    max-width: 44px;
    height: 24px;
    min-height: 24px;
    max-height: 24px;
    background-color: rgb(225, 220, 230);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    position: relative;
    overflow: hidden;
    transition-property: background-color;
    transition-duration: 0.18s;
}

.switch-pill .unity-toggle__checkmark {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    height: 20px;
    min-height: 20px;
    max-height: 20px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    border-bottom-right-radius: 10px;
    border-bottom-left-radius: 10px;
    background-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    position: absolute;
    top: 2px;
    left: 2px;
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
    transition-property: left, background-color;
    transition-duration: 0.18s;
}

.switch-pill:checked .unity-toggle__input {
    background-color: var(--primary-color);
}

.switch-pill:checked .unity-toggle__checkmark {
    left: 22px;
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

.switch-pill:checked > .unity-toggle__input > .unity-toggle__checkmark {
    left: 22px;
    background-color: rgb(255, 255, 255);
    background-image: none;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0);
}

