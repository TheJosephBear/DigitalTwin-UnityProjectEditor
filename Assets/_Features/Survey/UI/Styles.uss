.scale-dragger-tooltip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
    white-space: nowrap;
}

#unity-dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:focus .scale-dragger-tooltip {
    opacity: 1;
