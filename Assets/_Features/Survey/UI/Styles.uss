:root {
    --primary-color: rgb(103, 80, 164);
    --primary-hover: rgb(86, 61, 141);
    --primary-background-color: rgb(247, 242, 250);
    --secondary-background-color: rgb(246, 230, 255);
    --page-bg: rgb(251, 248, 253);
    --card-border: rgb(232, 224, 236);
    --card-hover-border: rgb(200, 184, 219);
    --card-active-border: rgb(103, 80, 164);
    --text-main: rgb(29, 25, 43);
    --text-muted: rgb(98, 91, 113);
    --input-bg: rgb(247, 245, 250);
    --input-hover-bg: rgb(242, 239, 247);
    --input-focus-bg: rgb(255, 255, 255);
}

#page-container {
    background-color: var(--page-bg);
}

.page-container {
    background-color: var(--page-bg);
}

#survey-scroll-view {
    background-color: var(--page-bg);
}

#survey-scroll-view #unity-content-container {
    padding-top: 30px;
    padding-right: 10%;
    padding-bottom: 80px;
    padding-left: 10%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

#survey-scroll-view .unity-scroll-view__content-container {
    padding-top: 20px;
    padding-right: 10%;
    padding-bottom: 80px;
    padding-left: 10%;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.unity-scroller {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 12px;
    margin-left: 0;
    position: relative;
}

#survey-scroll-view .unity-scroller {
    margin-top: 8px;
    margin-bottom: 8px;
    margin-right: 12px;
    margin-left: 0;
    position: relative;
}

.unity-scroller--vertical {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    background-color: transparent;
    border-width: 0;
    margin-right: 12px;
    margin-top: 8px;
    margin-bottom: 8px;
    position: relative;
}

.unity-scroller.unity-scroller--vertical {
    width: 20px;
    min-width: 20px;
    max-width: 20px;
    background-color: transparent;
    border-width: 0;
    margin-right: 12px;
    margin-top: 8px;
    margin-bottom: 8px;
    position: relative;
}

