}

.scale-slider {
    overflow: visible;
}

.scale-slider .unity-base-slider__dragger {
    overflow: visible;
}

.scale-slider .unity-base-slider__drag-container {
    overflow: visible;
}

.scale-slider .unity-base-slider__tracker {
    overflow: visible;
}

.scale-dragger-tooltip {
    position: absolute;
    bottom: 22px;
    left: 50%;
    translate: -50% 0;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    opacity: 0;
    transition-property: opacity, scale;
    transition-duration: 0.12s;
    scale: 0.8 0.8;
    white-space: nowrap;
}

#unity-dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

#unity-dragger:focus .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:hover .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.unity-base-slider__dragger:active .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-slider.is-dragging .scale-dragger-tooltip {
    opacity: 1;
    scale: 1 1;
}

.scale-dragger-tooltip.is-dragging {
    opacity: 1;
    scale: 1 1;
}

.scale-slider .unity-base-slider__tracker {
    background-color: rgba(103, 80, 164, 0.25);
    height: 6px;
    border-radius: 3px;
}

.add-scale-row-btn {
    width: 160px;
    height: 34px;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background-color: var(--primary-background-color);
    color: var(--primary-color);
    font-size: 13px;
    -unity-font-style: bold;
    border-width: 0;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.add-scale-row-btn:hover {
    background-color: var(--secondary-background-color);
}

.scale-viewer-row {
    flex-direction: row;
    align-items: center;
    width: 100%;
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.7);
    border-radius: 8px;
}

.scale-viewer-row-label {
    font-size: 15px;
    -unity-font-style: bold;
    color: rgb(40, 40, 40);
    min-width: 160px;
    max-width: 250px;
    flex-shrink: 0;
    white-space: normal;
}

.scale-value-badge {
    min-width: 32px;
    height: 28px;
    background-color: var(--primary-color);
    color: rgb(255, 255, 255);
    border-radius: 14px;
    -unity-text-align: middle-center;
    font-size: 14px;
    -unity-font-style: bold;
    margin-left: 12px;
}

#bottom-bar {
    flex-grow: 0;
    flex-direction: row-reverse;
    justify-content: flex-start;
    padding-right: 40px;
    padding-bottom: 12px;
    padding-left: 16px;
    padding-top: 12px;
    align-items: center;
    min-height: 52px;
    height: 52px;
    background-color: rgb(255, 255, 255);
    border-top-width: 1px;
    border-top-color: rgba(103, 80, 164, 0.12);
}

#bottom-bar #save-btn,
#bottom-bar #exit-btn {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    margin-left: 8px;
    background-color: transparent;
    -unity-background-image-tint-color: rgb(150, 145, 160);
    transition-property: background-color, -unity-background-image-tint-color;
    transition-duration: 0.15s;
}

#bottom-bar #save-btn:hover,
#bottom-bar #exit-btn:hover {
    background-color: var(--primary-background-color);
    -unity-background-image-tint-color: var(--primary-color);
}
